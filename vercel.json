{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "forest-bjorn-llc",
  "buildCommand": "npx nx build forest-bjorn-llc --configuration=production --skip-nx-cache",
  "outputDirectory": "dist/apps/forest-bjorn-llc/browser",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
